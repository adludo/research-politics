  "sections": [
    {
      "id": "budget",
      "title": "Budget, taxation and business",
      "note": "The Coalition’s cash-surplus target and Labor’s project savings target measure different things; they are not directly comparable budget totals.",
      "parties": [
        {
          "name": "Labor",
          "claims": [
            {
              "text": "Seek $2 billion in Suburban Rail Loop savings: approximately $1 billion through scope reductions and another $1 billion targeted through an independent review.",
              "source": "srl",
              "status": "verification-pending"
            },
            {
              "text": "Progressively restore the land-tax threshold to $300,000, starting with increases in 2027–28.",
              "source": "labor-land",
              "status": "verification-pending"
            },
            {
              "text": "Introduce a $350 million manufacturing package, targeting 5,000 jobs through grants and public–private investment.",
              "source": "abc",
              "status": "verification-pending"
            }
          ]
        },
        {
          "name": "Liberal–National Coalition",
          "claims": [
            {
              "text": "Target a cash surplus by 2032; freeze recruitment to back-office positions, claiming $22 billion in savings; use windfall revenue to reduce debt.",
              "source": "coalition-economy",
              "status": "verification-pending"
            },
            {
              "text": "Promise no new or increased taxes.",
              "source": "coalition-plan",
              "status": "verification-pending"
            },
            {
              "text": "Restore the $300,000 land-tax threshold over five years; provide business payroll-tax relief and remove payroll taxes applying to schools and GP services.",
              "source": "coalition-costs",
              "status": "verification-pending"
            }
          ]
        },
        {
          "name": "Greens",
          "claims": [
            {
              "text": "Introduce a quarterly 0.1% levy on Victoria’s share of the five major banks’ liabilities; increase online gambling tax to 25%, pokies taxes to 75%, and double casino table-game taxes; double coal and gas royalties; increase land tax on residential investment portfolios above $5 million. Use these taxes to fund expanded public services and household relief.",
              "source": "greens-tax",
              "status": "verification-pending"
            }
          ]
        },
        {
          "name": "One Nation",
          "claims": [
            {
              "text": "Cancel the Suburban Rail Loop and redirect its funding; reduce senior bureaucracy; introduce sunset reviews requiring government entities to justify their continuation.",
              "source": "one-fiscal",
              "status": "verification-pending"
            },
            {
              "text": "Wind back land-tax increases and lift the payroll-tax threshold. The supplied summary does not specify the new payroll threshold.",
              "source": "one-costs",
              "status": "verification-pending"
            }
          ]
        }
      ]
    },
    {
      "id": "cost-of-living",
      "title": "Cost of living and household assistance",
      "note": "",
      "parties": [
        {
          "name": "Labor",
          "claims": [
            {
              "text": "Introduce a $30 weekly public-transport cap, or $15 for concession holders, for two years from 1 January 2027.",
              "source": "labor-fares",
              "status": "verification-pending"
            },
            {
              "text": "Introduce a $30 weekly toll cap during 2027 through rebates capped at $350 a week and $5,000 per vehicle annually. Eligible small businesses could claim for up to five vehicles.",
              "source": "labor-tolls",
              "status": "verification-pending"
            }
          ]
        },
        {
          "name": "Liberal–National Coalition",
          "claims": [
            {
              "text": "Introduce a $50 weekly toll cap for two years from 1 July 2027, covering cars, light commercial vehicles and small-business fleets of up to five vehicles. Scrap the Emergency Services Tax.",
              "source": "coalition-costs",
              "status": "verification-pending"
            }
          ]
        },
        {
          "name": "Greens",
          "claims": [
            {
              "text": "Make public transport permanently free; trial 10 publicly owned supermarkets selling a basket of essential groceries at prices intended to be 30% cheaper; introduce $3,000 energy-upgrade vouchers for renters and homeowners.",
              "source": "greens-plan",
              "status": "verification-pending"
            }
          ]
        },
        {
          "name": "One Nation",
          "claims": [
            {
              "text": "Abolish stamp duty on home, contents and car insurance; provide $300 per school-age child annually for sport, split between summer and winter seasons, without means testing.",
              "source": "one-costs",
              "status": "verification-pending"
            }
          ]
        }
      ]
    },
    {
      "id": "health",
      "title": "Healthcare, dental and mental health",
      "note": "",
      "parties": [
        {
          "name": "Labor",
          "claims": [
            {
              "text": "Open 20 free public dental clinics, including six in regional Victoria. Make free annual check-ups available to Victorian residents, with treatment prioritised by urgency.",
              "source": "labor-dental",
              "status": "verification-pending"
            },
            {
              "text": "Expand 12 hospital emergency departments, adding 250 beds and 750 nurses.",
              "source": "labor-health",
              "status": "verification-pending"
            }
          ]
        },
        {
          "name": "Liberal–National Coalition",
          "claims": [
            {
              "text": "Deliver 25,000 additional elective operations annually through private-hospital partnerships at no additional patient cost; upgrade regional hospitals including West Gippsland, Wonthaggi and Mildura; establish a $50 million mental-health workforce fund; provide $5 million for a Parkville youth mental-health facility masterplan.",
              "source": "coalition-government",
              "status": "verification-pending"
            }
          ]
        },
        {
          "name": "Greens",
          "claims": [
            {
              "text": "Invest $3 billion in public dentistry, including clinics, prevention and workforce expansion, to make dental care free.",
              "source": "greens-plan",
              "status": "verification-pending"
            },
            {
              "text": "Allocate at least 5% of the health budget to prevention and health promotion, and 3% to community health; expand abortion access, pill testing and supervised injecting services.",
              "source": "abc",
              "status": "verification-pending"
            }
          ]
        },
        {
          "name": "One Nation",
          "claims": [
            {
              "text": "Create a real-time statewide surgical and specialist waiting-list system; improve electronic-record interoperability; expand hospital-at-home and nurse-led discharge; redirect administrative savings into clinical care.",
              "source": "one-health",
              "status": "verification-pending"
            },
            {
              "text": "Guarantee minimum regional services, including 24/7 emergency departments.",
              "source": "abc",
              "status": "verification-pending"
            },
            {
              "text": "Cover remaining public maternity out-of-pocket expenses and contribute $2,000 towards private maternity care.",
              "source": "one-costs",
              "status": "verification-pending"
            }
          ]
        }
      ]
    },
    {
      "id": "housing",
      "title": "Housing, renting and planning",
      "note": "",
      "parties": [
        {
          "name": "Labor",
          "claims": [
            {
              "text": "Partner with the Commonwealth to deliver 25,600 homes, giving first-home buyers an initial exclusive purchasing opportunity. Sell at market prices, with the first homes expected in 2027. Contribute $499 million in state funding, including supporting infrastructure.",
              "source": "labor-homes",
              "status": "verification-pending"
            }
          ]
        },
        {
          "name": "Liberal–National Coalition",
          "claims": [
            {
              "text": "Exempt first-home buyers from stamp duty on homes up to $1 million; scrap Labor’s suburban high-rise activity-centre plans and restore local planning control; expand the Capital City Zone into selected inner-city areas; accelerate growth-area land release.",
              "source": "coalition-costs",
              "status": "verification-pending"
            }
          ]
        },
        {
          "name": "Greens",
          "claims": [
            {
              "text": "Abolish stamp duty for owner-occupied homes below $1.1 million, with discounts up to $1.6 million; target 88,000 additional public homes, starting with $4 billion towards construction, maintenance and upgrades; oppose public-housing tower demolition.",
              "source": "greens-housing",
              "status": "verification-pending"
            },
            {
              "text": "Introduce a two-year rent freeze, followed by limits linked to wages or inflation.",
              "source": "abc",
              "status": "verification-pending"
            }
          ]
        },
        {
          "name": "One Nation",
          "claims": [
            {
              "text": "Release underused government land; impose statutory planning and building-approval deadlines; ease granny-flat and spare-room rental restrictions; increase foreign-purchaser duty; require community consultation before high-rise development.",
              "source": "one-costs",
              "status": "verification-pending"
            }
          ]
        }
      ]
    },
    {
      "id": "transport",
      "title": "Transport, roads and infrastructure",
      "note": "",
      "parties": [
        {
          "name": "Labor",
          "claims": [
            {
              "text": "Continue the Suburban Rail Loop with scope reductions and a savings review.",
              "source": "srl",
              "status": "verification-pending"
            },
            {
              "text": "Repair 500,000 potholes in 2026, upgrade 50 local roads and strengthen government responsibility for road maintenance. The supplied summary describes the pothole program as already underway, rather than entirely a future-term promise.",
              "source": "labor-roads",
              "status": "verification-pending"
            }
          ]
        },
        {
          "name": "Liberal–National Coalition",
          "claims": [
            {
              "text": "Pause and review the Suburban Rail Loop.",
              "source": "abc",
              "status": "verification-pending"
            },
            {
              "text": "Spend $5 billion on road repairs and resurfacing; target one million potholes; provide 25 hybrid electric trains for the Melton and Wyndham Vale lines.",
              "source": "coalition-costs",
              "status": "verification-pending"
            },
            {
              "text": "Guarantee regional Victoria at least 25% of infrastructure spending.",
              "source": "coalition-government",
              "status": "verification-pending"
            }
          ]
        },
        {
          "name": "Greens",
          "claims": [
            {
              "text": "Run trams and most trains at least every 10 minutes between 7am and 10pm, where infrastructure permits; spend $270 million on bus reform and $245 million on more frequent regional trains and coaches; allocate $80 million annually to safe cycling routes.",
              "source": "greens-transport",
              "status": "verification-pending"
            }
          ]
        },
        {
          "name": "One Nation",
          "claims": [
            {
              "text": "Cancel the Suburban Rail Loop, publish the costs of continuing versus stopping it, and redirect funding to other infrastructure.",
              "source": "one-fiscal",
              "status": "verification-pending"
            }
          ]
        }
      ]
    },
    {
      "id": "environment",
      "title": "Energy, climate and environment",
      "note": "",
      "parties": [
        {
          "name": "Labor",
          "claims": [
            {
              "text": "Pause and review the Western Renewables Link transmission project.",
              "source": "guardian",
              "status": "verification-pending"
            },
            {
